{
  "name": "astroagent-workbench",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:browser": "playwright test",
    "serve": "node server.mjs"
  },
  "dependencies": {
    "markdown-it": "15.0.3",
    "pinia": "3.0.4",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.15.0",
    "@vitejs/plugin-vue": "6.0.4",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.8",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "minimatch": "11.0.8",
    "glob": "14.0.6",
    "editorconfig": "4.0.0"
  }
}
