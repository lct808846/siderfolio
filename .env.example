# Copy to .env at the project root; existing environment variables take priority.
# Never commit a real key. Health checks and offline tests do not require one.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=60
# Per network operation at each endpoint: CDS primary, then Harvard mirror on failure.
SIMBAD_TIMEOUT_SECONDS=20
# Optional for SIMBAD; required only when executing ADS literature searches.
ADS_API_TOKEN=
ADS_TIMEOUT_SECONDS=20
# Public Gaia DR3 queries require no archive token.
GAIA_TIMEOUT_SECONDS=20
AGENT_MAX_ROUNDS=4
AGENT_MAX_TOOL_CALLS=6
# Local single-worker conversation service. Never use a shared/network directory.
ASTROAGENT_DATA_DIR=.astroagent
# JSON array; explicit browser origins, also used for actual write request checks.
ASTROAGENT_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000"]
