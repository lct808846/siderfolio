# Copy to .env.dev to change optional settings. The dev script creates its own credentials.
# The browser endpoint is http://127.0.0.1:5173.
ASTRO_DEV_COMPUTE=0
ASTRO_DEV_PLOTTING=0

# Optional existing, read-only model directories. Use absolute Windows paths with forward slashes.
# ASTRO_DEV_EMBEDDING_DIR=D:/models/embedding
# ASTRO_DEV_EMBEDDING_SHA256=
# ASTRO_DEV_OLLAMA_MODELS_DIR=D:/models/ollama/models
# ASTRO_DEV_OLLAMA_IMAGE=ollama/ollama@sha256:<digest>
# ASTRO_DEV_OLLAMA_DIGEST=sha256:<digest>
