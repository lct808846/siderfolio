# Run bash containers/gcp/deploy.sh prepare before editing the generated .env.
# SITE_MODE=domain for a DNS name or ip for a stable public IPv4. Host only, no scheme or port.
SITE_MODE=ip
PUBLIC_HOST=
# Optional apex alias when PUBLIC_HOST is the corresponding www domain.
APEX_REDIRECT_HOST=
ACME_EMAIL=

# Use a Gemini Developer API key and a model available to that Google project.
# Quote credentials with single quotes to keep literal dollar signs.
GEMINI_API_KEY=''
GEMINI_MODEL=gemini-3.5-flash
ADS_API_TOKEN=''

# These four fields are generated locally by deploy.sh prepare. Keep them on upgrades.
POSTGRES_PASSWORD=
ASTROAGENT_DB_PASSWORD=
ASTROAGENT_PROXY_TOKEN=
ASTROAGENT_AUTH_SECRET=

# Account activation and password recovery. Use TLS on 465 or STARTTLS on 587.
SMTP_HOST=
SMTP_PORT=465
SMTP_MODE=tls
SMTP_USER=''
SMTP_PASSWORD=''
SMTP_FROM=
REGISTRATION_ENABLED=true
REGISTRATION_LIMIT=10
TENANT_LIMIT=8
MODEL_REQUESTS_PER_HOUR=60
ASTRONOMY_QUERIES_PER_HOUR=120
ACCOUNT_STORAGE_MIB=1024
ACCOUNT_COMPUTE_QUEUED=2

# Start without a local LLM. Optional CPU simulation and local embedding are separate.
COMPUTE_ENABLED=0
# Set both for semantic RAG, then use deploy.sh --rag.
# EMBEDDING_MODEL_DIR=/srv/astroagent-models/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_MODEL_SHA256=

# Compose pins the default base images. Use repository@sha256 for replacements.
# PYTHON_IMAGE=
# NODE_IMAGE=
# DOCKER_CLI_IMAGE=
# POSTGRES_IMAGE=
# CADDY_IMAGE=
